# Public Supabase connection (local values are safe; never place service credentials here)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential; obtain the local value from `npm run db:start`
SUPABASE_SERVICE_ROLE_KEY=

# Provider modes remain disabled or fixture until an Owner completes activation.
PAYMENT_PROVIDER_MODE=fixture
EMAIL_PROVIDER_MODE=fixture
ASSISTANCE_PROVIDER_MODE=disabled
ANALYTICS_PROVIDER_MODE=disabled
MONITORING_PROVIDER_MODE=disabled

# Optional live-provider values. Leave blank until the matching mode is approved.
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
TBC_API_KEY=
# Optional for an approved sandbox or a local contract stub; live defaults to TBC's production API.
TBC_API_BASE_URL=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
OPENAI_API_KEY=
INTERNAL_JOB_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# Safe release/operations metadata. References identify approved evidence; they
# never contain credentials or customer data.
EPOCA_RELEASE=development
BUSINESS_TIME_ZONE=Asia/Tbilisi
BACKUP_MODE=disabled
CREDENTIAL_ROTATION_CONFIRMED=false
STAGING_SMOKE_REFERENCE=
MONITORING_CHECK_REFERENCE=
BACKUP_RESTORE_EVIDENCE_REFERENCE=
DOMAIN_ACTIVATION_REFERENCE=
LEGAL_APPROVAL_REFERENCE=
NETLIFY_SITE_ID=
MANAGED_SUPABASE_PROJECT_REF=
