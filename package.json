{
  "name": "epoca-online-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ÉPOCA multilingual online carpet shop",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/start-local.mjs",
    "build:local": "EPOCA_NEXT_MODE=build node scripts/start-local.mjs",
    "start:local": "EPOCA_NEXT_MODE=start node scripts/start-local.mjs",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:load:catalog": "node tests/load/catalog-search.js",
    "test:load:checkout": "node tests/load/checkout.js",
    "test:load:ingestion": "node tests/load/media-ingestion.js",
    "performance:check": "node scripts/performance/check-budgets.mjs",
    "performance:cost": "node scripts/performance/check-cost-usage.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "security:licenses": "node scripts/security/check-licenses.mjs",
    "security:artifacts": "node scripts/security/generate-artifacts.mjs",
    "cleanup:check": "node scripts/final-cleanup.mjs",
    "staff:local": "node scripts/create-local-staff.mjs",
    "env:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/check-env.mjs",
    "readiness:report": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/readiness-report.mjs",
    "release:smoke": "node scripts/release/smoke.mjs",
    "release:promote": "node scripts/release/promote.mjs",
    "release:rollback": "node scripts/release/rollback.mjs",
    "release:rollback:rehearse": "node scripts/release/rehearse-rollback.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "node scripts/check-database-types.mjs --write",
    "db:types:check": "node scripts/check-database-types.mjs",
    "db:migrations:check": "node scripts/database/check-migrations.mjs",
    "db:seed:verify": "node scripts/database/verify-seed.mjs",
    "db:drift:check": "node scripts/database/check-drift.mjs",
    "db:restore:rehearse": "node scripts/database/restore-rehearsal.mjs",
    "verify:baseline": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@uppy/core": "5.2.0",
    "@uppy/dashboard": "5.1.1",
    "@uppy/react": "5.1.1",
    "@uppy/tus": "5.1.1",
    "next": "16.3.2",
    "next-intl": "4.13.7",
    "openai": "7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.22.1",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/eslintrc": "3.3.3",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "fast-check": "4.5.3",
    "jsdom": "29.0.0",
    "msw": "2.12.14",
    "prettier": "3.8.2",
    "supabase": "2.115.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
